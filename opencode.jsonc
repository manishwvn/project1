{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "docs-langchain": {
      "type": "remote",
      "url": "https://docs.langchain.com/mcp",
      "headers": {
        "Accept": "application/json, text/event-stream"
      },
      "enabled": true
    },
    "reference-langchain": {
      "type": "remote",
      "url": "https://reference.langchain.com/mcp",
      "headers": {
        "Accept": "application/json, text/event-stream"
      },
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "sudo rm*": "deny",
      "sudo *": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git branch -D*": "deny",
      "chmod -R 777*": "deny",
      "npm publish*": "deny",
      "npm unpublish*": "deny",
      "*": "allow"
    }
  }
}
